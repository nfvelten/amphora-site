---
const RSS_URL = `${Astro.site ?? 'https://amphora-site.vercel.app'}rss.xml`;

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(path + '/');
const blogPaths = ['/blog', '/writing', '/posts', '/readings'];
---

<button class="mobile-menu-btn" id="mobile-menu-btn" title="Menu" aria-label="Abrir menu">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <line x1="3" y1="5" x2="17" y2="5" />
    <line x1="3" y1="10" x2="17" y2="10" />
    <line x1="3" y1="15" x2="17" y2="15" />
  </svg>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-content">
    <div class="sidebar-text">
      <a href="/" class="sidebar-name">Nicholas Velten</a>
      <nav>
        <a href="/about" class:list={[{ active: isActive('/about') }]}>
          <span class="lang-en">About</span><span class="lang-pt">Sobre</span>
        </a>
        <a href="/blog" class:list={[{ active: blogPaths.some(p => isActive(p)) }]}>Blog</a>
        <a href="/matecreations" class:list={[{ active: isActive('/matecreations') }]}>Mate Creations</a>
        <a href="/amphora" class:list={[{ active: isActive('/amphora') }]}>Amphora</a>
        <a href="/resume" class:list={[{ active: isActive('/resume') }]}>
          <span class="lang-en">Resume</span><span class="lang-pt">Currículo</span>
        </a>
      </nav>
    </div>

    <div class="sidebar-footer">
      <div class="rss-wrap">
        <button class="rss-btn" id="rss-copy" data-url={RSS_URL}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5" cy="19" r="3"/>
            <path d="M4 4a16 16 0 0 1 16 16h-3A13 13 0 0 0 4 7V4z"/>
            <path d="M4 11a9 9 0 0 1 9 9H10a6 6 0 0 0-6-6v-3z"/>
          </svg>
          <span id="rss-label">RSS</span>
        </button>
        <div class="rss-tooltip"><span class="lang-en">Copy feed link</span><span class="lang-pt">Copiar link do feed</span></div>
      </div>
      <button class="lang-toggle-btn" id="lang-toggle" title="Toggle language">
        <span class="lang-en">PT</span><span class="lang-pt">EN</span>
      </button>
    </div>
  </div>

  <button class="sidebar-toggle" id="sidebar-toggle" title="Recolher sidebar">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <polyline points="6,2 3,5 6,8" />
    </svg>
  </button>
</aside>

<script>
  const btn = document.getElementById('rss-copy') as HTMLButtonElement;
  const label = document.getElementById('rss-label');

  btn?.addEventListener('click', async () => {
    const url = btn.dataset.url ?? '';
    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add('copied');
      if (label) label.textContent = lang === 'pt' ? 'Copiado!' : 'Copied!';
      setTimeout(() => {
        btn.classList.remove('copied');
        if (label) label.textContent = 'RSS';
      }, 2000);
    } catch {
      window.open(url, '_blank');
    }
  });

  // ── Language toggle ───────────────────────────────────────────────
  const langToggle = document.getElementById('lang-toggle') as HTMLButtonElement;
  langToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-lang') || 'en';
    const next = current === 'en' ? 'pt' : 'en';
    document.documentElement.setAttribute('data-lang', next);
    document.documentElement.lang = next === 'pt' ? 'pt-BR' : 'en';
    localStorage.setItem('lang', next);
  });

  const sidebar = document.getElementById('sidebar') as HTMLElement;
  const toggle = document.getElementById('sidebar-toggle') as HTMLButtonElement;
  const toggleIcon = toggle?.querySelector('svg') as SVGElement;
  const backdrop = document.getElementById('sidebar-backdrop') as HTMLElement;
  const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;

  const isMobile = () => window.innerWidth <= 768;

  // ── Desktop: collapse/expand ──────────────────────────────────────
  if (localStorage.getItem('sidebar-collapsed') === 'true') {
    sidebar.classList.add('collapsed');
    document.querySelector('.wrapper')?.classList.add('sidebar-collapsed');
    if (toggleIcon) toggleIcon.style.transform = 'scaleX(-1)';
    if (toggle) toggle.title = 'Expandir sidebar';
  }

  toggle?.addEventListener('click', () => {
    if (isMobile()) return;
    const collapsed = sidebar.classList.toggle('collapsed');
    toggleIcon.style.transform = collapsed ? 'scaleX(-1)' : '';
    toggle.title = collapsed ? 'Expandir sidebar' : 'Recolher sidebar';
    document.querySelector('.wrapper')?.classList.toggle('sidebar-collapsed', collapsed);
    localStorage.setItem('sidebar-collapsed', String(collapsed));
  });

  // ── Mobile: drawer ────────────────────────────────────────────────
  function openMobileSidebar() {
    sidebar.classList.add('mobile-open');
    backdrop.classList.add('visible');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileSidebar() {
    sidebar.classList.remove('mobile-open');
    backdrop.classList.remove('visible');
    document.body.style.overflow = '';
  }

  mobileBtn?.addEventListener('click', () => {
    sidebar.classList.contains('mobile-open') ? closeMobileSidebar() : openMobileSidebar();
  });

  backdrop?.addEventListener('click', closeMobileSidebar);

  // Fecha o drawer ao navegar para outra página no mobile
  document.querySelectorAll('.sidebar nav a').forEach(link => {
    link.addEventListener('click', () => { if (isMobile()) closeMobileSidebar(); });
  });
</script>

<style>
  .lang-toggle-btn {
    background: none;
    border: 1px solid var(--ui);
    border-radius: 4px;
    color: var(--tx-3);
    cursor: pointer;
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.45rem;
    transition: color 0.15s, border-color 0.15s;
  }
  .lang-toggle-btn:hover {
    color: var(--tx);
    border-color: var(--ui-2);
  }
  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
