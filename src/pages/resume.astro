---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { portfolio } from '../data/portfolio.js';

const { person, positioning, experience, aiSystems, projects, education, certifications, skills } = portfolio;
---

<BaseLayout
  title="Resume — Nicholas Velten, Software Engineer"
  description="Professional background of Nicholas Velten — software engineer working across full-stack products, distributed workflows, production automation, and AI agent infrastructure."
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header reveal">
      <h1><span class="lang-en">Resume</span><span class="lang-pt">Curriculo</span></h1>
      <div class="meta">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        · <span class="lang-en">{person.location}</span><span class="lang-pt">{person.locationPt}</span>
        · <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        · <a href={person.links.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </header>

    <div class="prose lang-en">
      {positioning.summary.map((paragraph, i) => (
        <p class={`reveal reveal-delay-${Math.min(i + 1, 2)}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">Experience</h2>

      {experience.map((job, index) => (
        <details class="cv-entry reveal reveal-delay-1" open={index === 0}>
          <summary>
            <div class="cv-header">
              <strong>{job.company}</strong>
              {job.note && <span class="cv-note">({job.note})</span>}
              <span class="cv-period">{job.period}</span>
            </div>
            <div class="cv-role">{job.role}{job.location ? ` · ${job.location}` : ''}</div>
            {job.summary && <p class="cv-preview">{job.summary}</p>}
          </summary>
          <div class="cv-body">
            <ul>
              {job.highlights.map((item) => <li>{item}</li>)}
              <li><strong>Stack:</strong> {job.stack.join(', ')}</li>
            </ul>
          </div>
        </details>
      ))}

      <h2 class="reveal">AI Systems and Automation</h2>

      <p class="reveal reveal-delay-1">
        I run a personal agent platform against real work: policy enforcement at the tool boundary,
        human approval for sensitive calls, persistent memory across sessions, and closed-loop execution
        over a durable queue. Each piece exists because using agents against production systems surfaced
        the failure it prevents.
      </p>

      {aiSystems.map((system) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header"><strong><a href={system.url} target="_blank" rel="noopener">{system.name}</a></strong></div>
          <p>{system.description}</p>
          <div class="cv-role">{system.stack.join(' · ')}</div>
        </div>
      ))}

      <h2 class="reveal">Personal Projects</h2>

      {projects.map((project) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header">
            <strong><a href={project.href}>{project.name}</a></strong>
          </div>
          <p>{project.description}</p>
          <div class="cv-role">
            {project.tags.join(' · ')}{project.github ? ' · ' : ''}
            {project.github && <a href={project.github} target="_blank" rel="noopener">{project.github.replace('https://', '')}</a>}
          </div>
        </div>
      ))}

      <h2 class="reveal">Education</h2>

      {education.map((item) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header"><strong>{item.institution}</strong><span class="cv-period">{item.period}</span></div>
          <div class="cv-role">{item.degree}</div>
        </div>
      ))}

      <h2 class="reveal">Skills</h2>

      <div class="cv-skills">
        {skills.map((group) => (
          <div class="cv-skill-group reveal reveal-delay-1">
            <span class="cv-skill-label">{group.group}</span>
            <div class="cv-skill-tags">
              {group.items.map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>

      <h2 class="reveal">Certifications</h2>

      <ul class="cv-cert-list reveal reveal-delay-1">
        {certifications.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="prose lang-pt">
      {positioning.summaryPt.map((paragraph, i) => (
        <p class={`reveal reveal-delay-${Math.min(i + 1, 2)}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">Experiencia</h2>

      {experience.map((job, index) => (
        <details class="cv-entry reveal reveal-delay-1" open={index === 0}>
          <summary>
            <div class="cv-header">
              <strong>{job.companyPt ?? job.company}</strong>
              {job.notePt && <span class="cv-note">({job.notePt})</span>}
              <span class="cv-period">{job.periodPt}</span>
            </div>
            <div class="cv-role">{job.rolePt ?? job.role}{job.locationPt ? ` · ${job.locationPt}` : ''}</div>
            {job.summaryPt && <p class="cv-preview">{job.summaryPt}</p>}
          </summary>
          <div class="cv-body">
            <ul>
              {(job.highlightsPt ?? job.highlights).map((item) => <li>{item}</li>)}
              <li><strong>Stack:</strong> {job.stack.join(', ')}</li>
            </ul>
          </div>
        </details>
      ))}

      <h2 class="reveal">Sistemas de IA e automacao</h2>

      <p class="reveal reveal-delay-1">
        Opero uma plataforma pessoal de agentes em trabalho real: politica na fronteira de tools,
        aprovacao humana para chamadas sensiveis, memoria persistente entre sessoes e execucao em loop
        fechado sobre fila duravel. Cada peca existe porque usar agentes contra sistemas de producao
        revelou a falha que ela previne.
      </p>

      {aiSystems.map((system) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header"><strong><a href={system.url} target="_blank" rel="noopener">{system.name}</a></strong></div>
          <p>{system.descriptionPt ?? system.description}</p>
          <div class="cv-role">{system.stack.join(' · ')}</div>
        </div>
      ))}

      <h2 class="reveal">Projetos pessoais</h2>

      {projects.map((project) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header">
            <strong><a href={project.href}>{project.name}</a></strong>
          </div>
          <p>{project.descriptionPt ?? project.description}</p>
          <div class="cv-role">
            {project.tags.join(' · ')}{project.github ? ' · ' : ''}
            {project.github && <a href={project.github} target="_blank" rel="noopener">{project.github.replace('https://', '')}</a>}
          </div>
        </div>
      ))}

      <h2 class="reveal">Formacao</h2>

      {education.map((item) => (
        <div class="cv-entry reveal reveal-delay-1">
          <div class="cv-header"><strong>{item.institution}</strong><span class="cv-period">{item.period}</span></div>
          <div class="cv-role">{item.degreePt ?? item.degree}</div>
        </div>
      ))}

      <h2 class="reveal">Competencias</h2>

      <div class="cv-skills">
        {skills.map((group) => (
          <div class="cv-skill-group reveal reveal-delay-1">
            <span class="cv-skill-label">{group.groupPt ?? group.group}</span>
            <div class="cv-skill-tags">
              {group.items.map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>

      <h2 class="reveal">Certificacoes</h2>

      <ul class="cv-cert-list reveal reveal-delay-1">
        {certifications.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
.cv-entry { margin-bottom: 2.5rem; }
.cv-header { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.15rem; }
.cv-period { margin-left: auto; font-family: system-ui, sans-serif; font-size: 0.8rem; color: var(--tx-3); }
.cv-note { font-family: system-ui, sans-serif; font-size: 0.8rem; color: var(--tx-3); font-style: italic; }
.cv-role { font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--tx-2); margin-bottom: 0.6rem; }
.cv-preview { color: var(--tx-2); }
.cv-skills { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
.cv-skill-group { font-family: system-ui, sans-serif; font-size: 0.875rem; color: var(--tx-2); }
.cv-skill-label { font-weight: 600; color: var(--tx); margin-right: 0.5rem; }
.cv-skill-tags { display: inline-flex; gap: 0.35rem; flex-wrap: wrap; }
.cv-cert-list { margin: 0; padding-left: 1.2rem; }
.cv-cert-list li { font-family: system-ui, sans-serif; font-size: 0.875rem; color: var(--tx-2); margin-bottom: 0.25rem; }
</style>
