---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content: ContentEn } = await render(post);

const postsPt = await getCollection('posts-pt', ({ data }) => !data.draft);
const postPt = postsPt.find(p => p.id === post.id);
const rendered = postPt ? await render(postPt) : null;
const ContentPt = rendered?.Content;

function readingTime(body: string | undefined) {
  if (!body) return 1;
  return Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));
}
---

<PostLayout
  title={post.data.title}
  titlePt={postPt?.data.title}
  date={post.data.date}
  tags={post.data.tags}
  description={post.data.description}
  readingTime={readingTime(post.body)}
>
  <div class="lang-en">
    <ContentEn />
  </div>
  {ContentPt && (
    <div class="lang-pt">
      <ContentPt />
    </div>
  )}
</PostLayout>
