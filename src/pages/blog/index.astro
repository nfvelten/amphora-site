---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const leituras = (await getCollection('leituras', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const lendo = leituras.filter(l => l.data.status === 'lendo');
const lidos = leituras.filter(l => l.data.status === 'lido');
---

<BaseLayout
  title="Blog"
  description="Writing by Nicholas Velten on technology, tools and learnings."
>
  <Sidebar slot="sidebar" />
  <h1 class="page-heading">Blog</h1>
  <p class="page-desc">
    <span class="lang-en">Writing about technology, tools and learnings. No fixed agenda — just what's worth writing down.</span>
    <span class="lang-pt">Escrita sobre tecnologia, ferramentas e aprendizados do dia a dia. Sem pauta fixa — só o que vale registrar.</span>
  </p>

  <section class="blog-section">
    <div class="section-row">
      <h2 class="section-heading">
        <span class="lang-en">Writing</span>
        <span class="lang-pt">Escrita</span>
      </h2>
      <a href="/writing" class="see-all">
        <span class="lang-en">see all →</span>
        <span class="lang-pt">ver tudo →</span>
      </a>
    </div>
    <ul class="post-list">
      {posts.map(post => (
        <li class="post-item">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              <span class="lang-en">{post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <span class="lang-pt">{post.data.date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </time>
          </div>
          <a href={`/posts/${post.id.replace(/\.mdx?$/, '')}`} class="post-title">{post.data.title}</a>
          {post.data.description && (
            <p class="post-excerpt">{post.data.description}</p>
          )}
        </li>
      ))}
      {posts.length === 0 && (
        <li class="empty-state">
          <span class="lang-en">No posts published yet.</span>
          <span class="lang-pt">Nenhum post publicado ainda.</span>
        </li>
      )}
    </ul>
  </section>

  <section class="blog-section">
    <div class="section-row">
      <h2 class="section-heading">
        <span class="lang-en">Readings</span>
        <span class="lang-pt">Leituras</span>
      </h2>
      <a href="/readings" class="see-all">
        <span class="lang-en">see all →</span>
        <span class="lang-pt">ver tudo →</span>
      </a>
    </div>
    <ul class="post-list">
      {lendo.map(l => (
        <li class="post-item">
          <div class="post-meta">
            <span class="status-badge status-lendo">
              <span class="lang-en">Reading</span>
              <span class="lang-pt">Lendo</span>
            </span>
            {l.data.genero && <span>{l.data.genero}</span>}
          </div>
          <a href={`/readings/${l.id.replace(/\.md$/, '')}`} class="post-title">{l.data.title}</a>
          <p class="post-excerpt reading-autor">{l.data.autor}</p>
        </li>
      ))}
      {lidos.slice(0, 3).map(l => (
        <li class="post-item">
          <div class="post-meta">
            <time datetime={l.data.date.toISOString()}>
              <span class="lang-en">{l.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
              <span class="lang-pt">{l.data.date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}</span>
            </time>
            {l.data.genero && <span>{l.data.genero}</span>}
          </div>
          <a href={`/readings/${l.id.replace(/\.md$/, '')}`} class="post-title">{l.data.title}</a>
          <p class="post-excerpt reading-autor">{l.data.autor}</p>
        </li>
      ))}
      {leituras.length === 0 && (
        <li class="empty-state">
          <span class="lang-en">No readings logged yet.</span>
          <span class="lang-pt">Nenhuma leitura registrada ainda.</span>
        </li>
      )}
    </ul>
  </section>
</BaseLayout>
