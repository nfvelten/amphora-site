<style>
.cv-entry {
  margin-bottom: 2.5rem;
}

.cv-header {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.15rem;
}

.cv-period {
  margin-left: auto;
  font-family: system-ui, sans-serif;
  font-size: 0.8rem;
  color: var(--tx-3);
}

.cv-note {
  font-family: system-ui, sans-serif;
  font-size: 0.8rem;
  color: var(--tx-3);
  font-style: italic;
}

.cv-role {
  font-family: system-ui, sans-serif;
  font-size: 0.85rem;
  color: var(--tx-2);
  margin-bottom: 0.6rem;
}

.cv-skills {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}

.cv-skill-group {
  font-family: system-ui, sans-serif;
  font-size: 0.875rem;
  color: var(--tx-2);
}

.cv-skill-label {
  font-weight: 600;
  color: var(--tx);
  margin-right: 0.5rem;
}

.cv-cert-group {
  margin-bottom: 1.5rem;
}

.cv-cert-label {
  font-family: system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--tx-3);
  display: block;
  margin-bottom: 0.4rem;
}

.cv-cert-list {
  margin: 0;
  padding-left: 1.2rem;
}

.cv-cert-list li {
  font-family: system-ui, sans-serif;
  font-size: 0.875rem;
  color: var(--tx-2);
  margin-bottom: 0.25rem;
}
</style>
