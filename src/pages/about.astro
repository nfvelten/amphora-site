---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does Nicholas Velten do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nicholas Velten is a full-stack software engineer focused on building scalable, well-structured systems. He works at Alloha Fibra developing applications and services with Java, TypeScript, Vue.js and Node.js, with around four years of experience across telecommunications, fintechs and product startups.',
      },
    },
    {
      '@type': 'Question',
      name: 'What technologies does Nicholas Velten use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'At work, Nicholas primarily uses Java, TypeScript, Vue.js and Node.js. In his personal setup, he uses Linux with Hyprland as window manager, Neovim as code editor and Obsidian for knowledge management.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I contact Nicholas Velten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can reach him by email at nikvelten@gmail.com or on LinkedIn at linkedin.com/in/nicholasveltenfullstack.',
      },
    },
  ],
};
---

<BaseLayout
  title="About Nicholas Velten — Full-Stack Software Engineer"
  description="Nicholas Velten — full-stack software engineer with 4+ years of experience in Java, TypeScript, Vue.js and Node.js."
  jsonLd={faqSchema}
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header">
      <h1><span class="lang-en">About</span><span class="lang-pt">Sobre</span></h1>
      <div class="meta"><span class="lang-en">Full-Stack Software Engineer</span><span class="lang-pt">Engenheiro de Software Full-Stack</span></div>
    </header>

    <div class="prose lang-en">
      <p>
        I'm Nicholas Velten, a full-stack software engineer with <strong>4+ years of experience</strong>
        building production systems. I currently work at Alloha Fibra — Brazil's largest independent ISP —
        developing critical APIs, voice infrastructure monitoring and system migrations. I've worked across
        telecommunications, fintechs and product startups.
      </p>

      <p>
        I like understanding systems end to end — from the database to the UI component.
        I care about clean code, architecture that makes sense and tools that stay the way you set them up.
        Day to day I use Linux with Hyprland, Neovim as my editor and Obsidian to maintain a vault of
        technical and personal notes.
      </p>

      <p>
        Outside of work I'm a fan of nerd and geek culture — comics, movies, series, RPG and strategy games.
        I read a lot and browse used bookstores whenever I can. Married to Andressa, we have three cats:
        Sigmund Freud, Ronald Weasley and Trinity Matrix. I listen to a lot of music — electronic, ambient,
        jazz, cumbia, hip-hop, rock and metal. I drink mate, tererê and coffee. I'm from Maringá, Paraná.
      </p>

      <h2>Main stack</h2>

      <ul>
        <li><strong>Back-end:</strong> Node.js, TypeScript, NestJS, Python, Java, Spring Boot, Rust</li>
        <li><strong>Front-end:</strong> Vue.js, Nuxt.js, React.js, Next.js, Tailwind CSS</li>
        <li><strong>Infrastructure:</strong> Docker, Kubernetes, AWS, GCP, OCI, Terraform, CI/CD</li>
        <li><strong>Databases:</strong> PostgreSQL, Redis, MySQL</li>
        <li><strong>Observability:</strong> New Relic, Grafana, Sentry, OpenTelemetry</li>
        <li><strong>Practices:</strong> DDD, Hexagonal Architecture, Clean Architecture, SOLID, Event-Driven</li>
        <li><strong>Personal tools:</strong> Neovim, Obsidian, Hyprland (Linux)</li>
      </ul>

      <h2>Experience</h2>

      <ul>
        <li>
          <strong>Alloha Fibra</strong> — Full-Stack Engineer (Jul. 2023 – present).
          Critical performance APIs, voice channel monitoring system and migrations for
          Brazil's largest independent ISP.
        </li>
        <li>
          <strong>LIGUE</strong> <em>(acquired by Alloha)</em> — Full-Stack Engineer
          (May 2022 – Jul. 2023). Multi-layer service platform (TDA), asynchronous queues
          with Redis and APIs integrated with the fiber coverage geographic system.
        </li>
        <li>
          <strong>Kinebot</strong> — Full-Stack Engineer (Feb. 2022 – May 2022).
          Web applications with Node.js, React and AWS (Lambda, S3, RDS).
        </li>
        <li>
          <strong>GetHash</strong> — Full-Stack Engineer (Oct. 2021 – Feb. 2022).
          Solutions for multiple clients with Node.js, React, TypeScript and infrastructure
          with Docker, Kubernetes and DigitalOcean.
        </li>
      </ul>

      <h2>Personal projects</h2>

      <ul>
        <li>
          <strong><a href="/amphora">Amphora</a></strong> — PKMS built to reduce cognitive load and externalize thinking into structured notes. Automation of voice recordings, meetings and content ingestion via AI; integration with Neovim and Claude Code. <em>Bash, Python, Claude API, Obsidian, Neovim</em>
        </li>
        <li>
          <strong><a href="/matecreations">Mate Creations</a></strong> — Theme ecosystem for
          Obsidian, Neovim, VS Code and Zen Browser with automatic light/dark switching via
          systemd and a release pipeline in GitHub Actions.
        </li>
        <li>
          <strong><a href="/arbitus">Arbitus</a></strong> — Open-source security proxy for AI agents and MCP servers. Enforces per-agent policies: auth, rate limiting, payload filtering, HITL and audit log. <em>Rust</em>
        </li>
      </ul>

      <p>
        Degree in Software Engineering (Estácio) and Systems Analysis and Development
        (Centro Universitário Integrado, 2018–2021). Fluent English — C2 by EF SET.
      </p>

      <p>
        <a href="/resume">Full resume</a> ·
        <a href="https://github.com/nfvelten" target="_blank" rel="noopener">GitHub</a> ·
        <a href="https://www.linkedin.com/in/nicholasveltenfullstack" target="_blank" rel="noopener">LinkedIn</a> ·
        <a href="mailto:nikvelten@gmail.com">nikvelten@gmail.com</a>
      </p>
    </div>

    <div class="prose lang-pt">
      <p>
        Sou Nicholas Velten, engenheiro de software full-stack com <strong>4+ anos de experiência</strong>
        construindo sistemas em produção. Trabalho atualmente na Alloha Fibra — maior ISP independente
        do Brasil — desenvolvendo APIs críticas, monitoramento de infraestrutura de voz e migrações de
        sistema. Passei por telecomunicações, fintechs e startups de produto.
      </p>

      <p>
        Gosto de entender sistemas por inteiro — do banco de dados ao componente de interface.
        Tenho apreço por código limpo, arquitetura que faz sentido e ferramentas que ficam do
        jeito que você quer. No dia a dia uso Linux com Hyprland, Neovim como editor e Obsidian
        para manter um vault de notas técnicas e pessoais.
      </p>

      <p>
        Fora do trabalho sou fã de cultura nerd e geek — quadrinhos, filmes, séries, RPG e jogos
        de estratégia. Leio bastante, frequento sebos sempre que posso. Casado com Andressa,
        temos três gatos: Sigmund Freud, Ronald Weasley e Trinity Matrix. Ouço muita música —
        eletrônica, ambient, jazz, cumbia, hip-hop, rock e metal. Bebo mate, tererê e café.
        Sou de Maringá, Paraná.
      </p>

      <h2>Stack principal</h2>

      <ul>
        <li><strong>Back-end:</strong> Node.js, TypeScript, NestJS, Python, Java, Spring Boot, Rust</li>
        <li><strong>Front-end:</strong> Vue.js, Nuxt.js, React.js, Next.js, Tailwind CSS</li>
        <li><strong>Infraestrutura:</strong> Docker, Kubernetes, AWS, GCP, OCI, Terraform, CI/CD</li>
        <li><strong>Banco de dados:</strong> PostgreSQL, Redis, MySQL</li>
        <li><strong>Observabilidade:</strong> New Relic, Grafana, Sentry, OpenTelemetry</li>
        <li><strong>Práticas:</strong> DDD, Hexagonal Architecture, Clean Architecture, SOLID, Event-Driven</li>
        <li><strong>Ferramentas pessoais:</strong> Neovim, Obsidian, Hyprland (Linux)</li>
      </ul>

      <h2>Experiência</h2>

      <ul>
        <li>
          <strong>Alloha Fibra</strong> — Full-Stack Engineer (jul. 2023 – presente).
          APIs de performance crítica, sistema de monitoramento de canais de voz e
          migrações para o maior ISP independente do Brasil.
        </li>
        <li>
          <strong>LIGUE</strong> <em>(adquirida pela Alloha)</em> — Full-Stack Engineer
          (mai. 2022 – jul. 2023). Plataforma de atendimento multi-camada (TDA), filas
          assíncronas com Redis e APIs integradas ao sistema geográfico de cobertura de fibra.
        </li>
        <li>
          <strong>Kinebot</strong> — Full-Stack Engineer (fev. 2022 – mai. 2022).
          Aplicações web com Node.js, React e AWS (Lambda, S3, RDS).
        </li>
        <li>
          <strong>GetHash</strong> — Full-Stack Engineer (out. 2021 – fev. 2022).
          Soluções para múltiplos clientes com Node.js, React, TypeScript e infraestrutura
          com Docker, Kubernetes e DigitalOcean.
        </li>
      </ul>

      <h2>Projetos pessoais</h2>

      <ul>
        <li>
          <strong><a href="/amphora">Amphora</a></strong> — PKMS construído para reduzir carga cognitiva e externalizar o pensamento em notas estruturadas. Automação de gravações de voz, reuniões e ingestão de conteúdo via IA; integração com Neovim e Claude Code. <em>Bash, Python, Claude API, Obsidian, Neovim</em>
        </li>
        <li>
          <strong><a href="/matecreations">Mate Creations</a></strong> — Ecossistema de temas para
          Obsidian, Neovim, VS Code e Zen Browser com alternância automática claro/escuro via
          systemd e pipeline de release no GitHub Actions.
        </li>
        <li>
          <strong><a href="/arbitus">Arbitus</a></strong> — Proxy de segurança open-source para agentes de IA e servidores MCP. Aplica políticas por agente: autenticação, rate limiting, filtragem de payload, HITL e auditoria. <em>Rust</em>
        </li>
      </ul>

      <p>
        Formação em Engenharia de Software (Estácio) e Análise e Desenvolvimento de Sistemas
        (Centro Universitário Integrado, 2018–2021). Inglês fluente — C2 pelo EF SET.
      </p>

      <p>
        <a href="/resume">Currículo completo</a> ·
        <a href="https://github.com/nfvelten" target="_blank" rel="noopener">GitHub</a> ·
        <a href="https://www.linkedin.com/in/nicholasveltenfullstack" target="_blank" rel="noopener">LinkedIn</a> ·
        <a href="mailto:nikvelten@gmail.com">nikvelten@gmail.com</a>
      </p>
    </div>
  </article>
</BaseLayout>
