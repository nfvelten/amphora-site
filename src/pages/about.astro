---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { portfolio } from '../data/portfolio.js';

const { person, positioning, experience, projects, skills } = portfolio;
const mainExperience = experience[0];
const featuredProjects = projects.filter((project) => ['Arbitus', 'agent-memory', 'Agent Code Buddy', 'Paperboy', 'Mate Creations', 'keybinds-tui'].includes(project.name));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does Nicholas Velten do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${person.publicName} is a ${person.title} working across full-stack products, distributed workflows, production automation and AI agent infrastructure, with current domain experience in ISP OSS/BSS and service assurance.`,
      },
    },
    {
      '@type': 'Question',
      name: 'What technologies does Nicholas Velten use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nicholas primarily uses Java, Spring Boot, Vue.js, Python, PostgreSQL, MySQL, Redis, Kafka, Docker, Kubernetes, Grafana, Loki and Rust.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I contact Nicholas Velten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `You can reach him by email at ${person.email} or on LinkedIn at linkedin.com/in/nicholasvelten.`,
      },
    },
  ],
};
---

<BaseLayout
  title="About Nicholas Velten — Software Engineer"
  description={positioning.headline}
  jsonLd={faqSchema}
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header reveal">
      <h1><span class="lang-en">About</span><span class="lang-pt">Sobre</span></h1>
      <div class="meta"><span class="lang-en">{person.title}</span><span class="lang-pt">Engenheiro de Software</span></div>
    </header>

    <div class="prose lang-en">
      {positioning.summary.map((paragraph, i) => (
        <p class={`reveal reveal-delay-${Math.min(i + 1, 2)}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">Main Stack</h2>
      <ul class="reveal reveal-delay-1">
        {skills.map((group) => <li><strong>{group.group}:</strong> {group.items.join(', ')}</li>)}
      </ul>

      <h2 class="reveal">Experience</h2>
      <ul class="reveal reveal-delay-1">
        <li>
          <strong>{mainExperience.company}</strong> — {mainExperience.role} ({mainExperience.period}).
          {' '}{mainExperience.summary}
        </li>
        {experience.slice(1).map((job) => (
          <li><strong>{job.company}</strong> — {job.role} ({job.period}). {job.highlights[0]}</li>
        ))}
      </ul>

      <h2 class="reveal">Personal Projects</h2>
      <ul class="reveal reveal-delay-1">
        {featuredProjects.map((project) => (
          <li><strong><a href={project.href}>{project.name}</a></strong> — {project.description} <em>{project.tags.join(', ')}</em></li>
        ))}
      </ul>

      <p class="reveal">
        Systems Analysis and Development — Centro Universitario Integrado (2018-2021). English C2 by EF SET.
      </p>

      <p class="reveal">
        <a href="/resume">Full resume</a> ·
        <a href={person.links.github} target="_blank" rel="noopener">GitHub</a> ·
        <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
    </div>

    <div class="prose lang-pt">
      {positioning.summaryPt.map((paragraph, i) => (
        <p class={`reveal reveal-delay-${Math.min(i + 1, 2)}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">Stack principal</h2>
      <ul class="reveal reveal-delay-1">
        {skills.map((group) => <li><strong>{group.groupPt ?? group.group}:</strong> {group.items.join(', ')}</li>)}
      </ul>

      <h2 class="reveal">Experiencia</h2>
      <ul class="reveal reveal-delay-1">
        <li>
          <strong>{mainExperience.companyPt}</strong> — {mainExperience.rolePt} ({mainExperience.periodPt}).
          {' '}{mainExperience.summaryPt}
        </li>
        {experience.slice(1).map((job) => (
          <li><strong>{job.companyPt ?? job.company}</strong> — {job.rolePt ?? job.role} ({job.periodPt}). {(job.highlightsPt ?? job.highlights)[0]}</li>
        ))}
      </ul>

      <h2 class="reveal">Projetos pessoais</h2>
      <ul class="reveal reveal-delay-1">
        {featuredProjects.map((project) => (
          <li><strong><a href={project.href}>{project.name}</a></strong> — {project.descriptionPt ?? project.description} <em>{project.tags.join(', ')}</em></li>
        ))}
      </ul>

      <p class="reveal">
        Analise e Desenvolvimento de Sistemas — Centro Universitario Integrado (2018-2021). Ingles C2 pelo EF SET.
      </p>

      <p class="reveal">
        <a href="/resume">Curriculo completo</a> ·
        <a href={person.links.github} target="_blank" rel="noopener">GitHub</a> ·
        <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
    </div>
  </article>
</BaseLayout>
