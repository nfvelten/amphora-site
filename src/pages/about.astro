---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does Nicholas Velten do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nicholas Velten is a Senior Software Engineer with 4+ years at Alloha Fibra — Brazil\'s largest independent ISP — owning platform-level infrastructure across a distributed Java/Spring Boot microservices stack. He operates with end-to-end feature ownership and has led cross-cutting framework migrations and security remediations across a platform serving millions of customers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What technologies does Nicholas Velten use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'At work, Nicholas primarily uses Java, Spring Boot, Vue.js, Node.js and TypeScript. In personal projects he writes Rust (Arbitus) and TypeScript (Ralph Explorer). His personal setup runs Linux with Hyprland, Neovim as editor and Obsidian for knowledge management.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I contact Nicholas Velten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can reach him by email at nikvelten@gmail.com or on LinkedIn at linkedin.com/in/nicholasvelten.',
      },
    },
  ],
};
---

<BaseLayout
  title="About Nicholas Velten — Senior Software Engineer"
  description="Nicholas Velten — Senior Software Engineer with 4+ years of experience in Java, Spring Boot, distributed systems, and platform-level infrastructure."
  jsonLd={faqSchema}
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header reveal">
      <h1><span class="lang-en">About</span><span class="lang-pt">Sobre</span></h1>
      <div class="meta"><span class="lang-en">Senior Software Engineer</span><span class="lang-pt">Engenheiro de Software Sênior</span></div>
    </header>

    <div class="prose lang-en">
      <p class="reveal reveal-delay-1">
        I'm Nicholas Velten, a Senior Software Engineer with <strong>4+ years of experience</strong>
        at Brazil's largest independent ISP, owning platform-level infrastructure across a distributed
        Java/Spring Boot microservices stack serving millions of customers. I operate with end-to-end
        feature ownership — requirements gathering, stakeholder alignment, technical refinement, and
        implementation — without dedicated PM support.
      </p>

      <p class="reveal reveal-delay-2">
        I like understanding systems end to end — from the shared library to the UI component.
        I care about clean code, architecture that makes sense and tools that stay the way you set them up.
        Day to day I use Linux with Hyprland, Neovim as my editor and Obsidian to maintain a vault of
        technical and personal notes.
      </p>

      <p class="reveal reveal-delay-2">
        Outside of work I'm a fan of nerd and geek culture — comics, movies, series, RPG and strategy games.
        I read a lot and browse used bookstores whenever I can. Married to Andressa, we have three cats:
        Sigmund Freud, Ronald Weasley and Trinity Matrix. I listen to a lot of music — electronic, ambient,
        jazz, cumbia, hip-hop, rock and metal. I drink mate, tererê and coffee. I'm from Maringá, Paraná.
      </p>

      <h2 class="reveal">Main stack</h2>

      <ul class="reveal reveal-delay-1">
        <li><strong>Back-end:</strong> Java, Spring Boot, Node.js, TypeScript, NestJS, Python, Go, Rust</li>
        <li><strong>Front-end:</strong> Vue.js, Nuxt.js, React.js, Next.js, Tailwind CSS</li>
        <li><strong>Infrastructure:</strong> Docker, Kubernetes, AWS, GCP, OCI, Terraform, CI/CD</li>
        <li><strong>Databases:</strong> PostgreSQL, Redis, MySQL</li>
        <li><strong>Observability:</strong> New Relic, Grafana, Sentry, OpenTelemetry</li>
        <li><strong>Practices:</strong> DDD, Hexagonal Architecture, Clean Architecture, SOLID, Event-Driven</li>
        <li><strong>Personal tools:</strong> Neovim, Obsidian, Hyprland (Linux)</li>
      </ul>

      <h2 class="reveal">Experience</h2>

      <ul class="reveal reveal-delay-1">
        <li>
          <strong>Alloha Fibra</strong> — Senior Software Engineer (Jul. 2023 – present).
          Platform-level infrastructure across 8+ Java/Spring Boot microservices. Led JDBC
          framework migration, remediated a critical LGPD violation across 3 services,
          authored Java 17 + Spring Boot 3 migration assessment.
        </li>
        <li>
          <strong>LIGUE</strong> <em>(acquired by Alloha)</em> — Full-Stack Engineer
          (May 2022 – Jul. 2023). Multi-layer service platform (TDA), asynchronous queues
          with Redis and APIs integrated with the fiber coverage geographic system.
        </li>
        <li>
          <strong>Kinebot</strong> — Full-Stack Engineer (Feb. 2022 – May 2022).
          Web applications with Node.js, React and AWS (Lambda, S3, RDS).
        </li>
        <li>
          <strong>GetHash</strong> — Full-Stack Engineer (Oct. 2021 – Feb. 2022).
          Solutions for multiple clients with Node.js, React, TypeScript and infrastructure
          with Docker, Kubernetes and DigitalOcean.
        </li>
      </ul>

      <h2 class="reveal">Personal projects</h2>

      <ul class="reveal reveal-delay-1">
        <li>
          <strong><a href="/amphora">Amphora</a></strong> — PKMS built to reduce cognitive load and externalize thinking into structured notes. Automation of voice recordings, meetings and content ingestion via AI; integration with Neovim and Claude Code. <em>Bash, Python, Claude API, Obsidian, Neovim</em>
        </li>
        <li>
          <strong><a href="/matecreations">Mate Creations</a></strong> — Theme ecosystem for
          Obsidian, Neovim, VS Code and Zen Browser with automatic light/dark switching via
          systemd and a release pipeline in GitHub Actions.
        </li>
        <li>
          <strong><a href="/arbitus">Arbitus</a></strong> — Open-source security proxy for AI agents and MCP servers. Enforces per-agent policies: auth, rate limiting, payload filtering, HITL and audit log. <em>Rust</em>
        </li>
        <li>
          <strong>Phone Development Deck</strong> — Distributed platform across three nodes: Arch Linux (orchestration), Android/Termux (LineageOS + root, Moto G7 Play), and Kubernetes (k3s on Contabo VPS). Go CLI (<code>deck</code>) bridges all three: SSH phone queries, kubectl proxy to k3s, vault captures to Obsidian. Three native Java Android apps (no Gradle): Field Console (ops dashboard), Amphora Zero (firmware-style security lab with Termux module bridge), Agent Code Buddy (mobile HITL for AI agent approvals, long-poll, accelerometer states). K8s: cert-manager, Cloudflare DNS, Uptime Kuma, systemd backups, UFW hardening. <em>Go, Java (Android), Python, k3s, Bash</em>
        </li>
        <li>
          <strong>Ralph Explorer</strong> — CLI that parses Java and Vue.js source code to generate dependency graphs and visual dev portals across a multi-repo codebase. <em>TypeScript, React</em>
        </li>
        <li>
          <strong>Paperboy</strong> — Keyboard-first RSS reader and podcast player replacing the new tab page. Published on Firefox Add-ons. Companion terminal UI in Rust. <em>JavaScript, Rust</em>
        </li>
      </ul>

      <p class="reveal">
        Systems Analysis and Development — Centro Universitário Integrado (2018–2021). Fluent English — C2 by EF SET.
      </p>

      <p class="reveal">
        <a href="/resume">Full resume</a> ·
        <a href="https://github.com/nfvelten" target="_blank" rel="noopener">GitHub</a> ·
        <a href="https://www.linkedin.com/in/nicholasvelten" target="_blank" rel="noopener">LinkedIn</a> ·
        <a href="mailto:nikvelten@gmail.com">nikvelten@gmail.com</a>
      </p>
    </div>

<div class="prose lang-pt">
