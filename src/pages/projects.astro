---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { portfolio } from '../data/portfolio.js';

const projects = portfolio.projects;
---

<BaseLayout
  title="Open-Source Projects — Paperboy, Arbitus, agent-memory, Amphora"
  description="Open-source projects by Nicholas Velten: Paperboy, Arbitus, agent-memory, Amphora, and Mate Creations."
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header">
      <h1>
        <span class="lang-en">Projects</span>
        <span class="lang-pt">Projetos</span>
      </h1>
    </header>
    <div class="prose">
      <div class="projects-list">
        {projects.map((p, i) => (
          <a href={p.href} class={`project-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="project-logo">
              {p.logo
                ? <img src={p.logo} alt={p.name} width="40" height="40" />
                : <span class="project-initial">{p.name[0]}</span>
              }
            </div>
            <div class="project-body">
              <div class="project-top">
                <h2>{p.name}</h2>
                <div class="project-tags">
                  {p.tags.map(t => <span class="tag">{t}</span>)}
                </div>
              </div>
              <p class="project-tagline">
                <span class="lang-en">{p.tagline}</span>
                <span class="lang-pt">{p.taglinePt}</span>
              </p>
              <p class="project-desc">
                <span class="lang-en">{p.description}</span>
                <span class="lang-pt">{p.descriptionPt}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--tx) 8%, transparent);
    border-color: var(--ui-2);
  }

  .project-logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .project-logo img {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
  }

  .project-initial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    font-size: 1rem;
    font-weight: 600;
    color: var(--tx-2);
  }

  .project-body {
    flex: 1;
    min-width: 0;
  }

  .project-top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .project-top h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    color: var(--tx-3);
    font-family: system-ui, sans-serif;
    transition: background 0.15s, border-color 0.15s;
  }

  .project-card:hover .tag {
    background: var(--bg-2);
    border-color: var(--ui-2);
  }

  .project-tagline {
    font-size: 0.85rem;
    color: var(--tx-2);
    margin-bottom: 0.4rem;
  }

  .project-desc {
    font-size: 0.82rem;
    color: var(--tx-3);
    line-height: 1.5;
    margin: 0;
  }
</style>
