---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const projects = [
  {
    name: 'Paperboy',
    tagline: 'RSS reader and podcast player as your new tab',
    taglinePt: 'Leitor de RSS e podcast player como nova aba do browser',
    description: 'Keyboard-first, local-first browser extension. RSS 2.0 & Atom feeds, podcast queue, article reader — all stored as plain files in ~/paperboy/. Available on Firefox Add-ons. Also available as a terminal UI (paperboy-tui) built with Ratatui.',
    descriptionPt: 'Extensão de browser keyboard-first e local-first. Feeds RSS 2.0 & Atom, fila de podcasts, leitor de artigos — tudo em arquivos simples em ~/paperboy/. Disponível no Firefox Add-ons. Também disponível como TUI (paperboy-tui) construído com Ratatui.',
    href: '/paperboy',
    github: 'https://github.com/harbefas/paperboy',
    logo: '/paperboy-logo.png',
    tags: ['JavaScript', 'Firefox', 'RSS'],
  },
  {
    name: 'Arbitus',
    tagline: 'Security proxy for AI agents and MCP servers',
    taglinePt: 'Proxy de segurança para agentes de IA e servidores MCP',
    description: 'Open-source proxy that enforces per-agent policies — auth, rate limiting, payload filtering, HITL, and audit — before any tool call reaches your MCP server.',
    descriptionPt: 'Proxy open-source que aplica políticas por agente — autenticação, rate limiting, filtragem de payload, HITL e auditoria — antes que qualquer tool call chegue ao servidor upstream.',
    href: '/arbitus',
    github: 'https://github.com/arbitusgateway/arbitus',
    logo: '/arbitus-logo.png',
    tags: ['Rust', 'MCP', 'Security'],
  },
  {
    name: 'Amphora',
    tagline: 'Personal knowledge management system',
    taglinePt: 'Sistema pessoal de gestão de conhecimento',
    description: 'A PKMS built on Obsidian and Neovim. Combines daily notes, script automation and AI integration to capture, organize and retrieve knowledge without friction.',
    descriptionPt: 'Um PKMS construído sobre Obsidian e Neovim. Combina daily notes, automações via scripts e integração com IA para capturar, organizar e recuperar conhecimento sem atrito.',
    href: '/amphora',
    github: 'https://github.com/nfvelten/amphora-setup',
    logo: '/icon.webp',
    tags: ['Rust', 'Obsidian', 'Neovim'],
  },
  {
    name: 'Agent Code Buddy',
    tagline: 'Mobile HITL companion for AI coding agents',
    taglinePt: 'Companion mobile de HITL para agentes de IA',
    description: 'Python HTTP server on your PC intercepts Claude agent tool calls via pre-tool-use hook. Native Android app lets you approve or deny from the notification shade. Long-poll, no push infra needed. Robot pet with accelerometer-driven states.',
    descriptionPt: 'Servidor Python HTTP no PC intercepta tool calls de agentes Claude via hook de pre-tool-use. App Android nativo permite aprovar ou negar da aba de notificações. Long-poll, sem infra de push. Pet robô com estados via acelerômetro.',
    href: '/agent-code-buddy',
    github: 'https://github.com/nfvelten/agent-code-buddy-unified',
    logo: null,
    tags: ['Python', 'Android', 'HITL'],
  },
  {
    name: 'Amphora Zero',
    tagline: 'Firmware-style security lab console for Android',
    taglinePt: 'Console de lab de segurança estilo firmware para Android',
    description: 'Module catalog for security research on owned and authorized devices. Each module maps to a Termux script. Results return via Android broadcasts. Active: Wi-Fi recon (iproute2, bettercap). Planned: BLE, Evil Twin. No Gradle, plain Java.',
    descriptionPt: 'Catálogo de módulos para pesquisa de segurança em dispositivos próprios e autorizados. Cada módulo mapeia para script Termux. Resultados retornam via broadcasts Android. Ativo: recon Wi-Fi (iproute2, bettercap). Planejado: BLE, Evil Twin. Sem Gradle, Java puro.',
    href: '/amphora-zero',
    github: 'https://github.com/nfvelten/amphora-zero',
    logo: null,
    tags: ['Android', 'Security', 'Termux'],
  },
  {
    name: 'Phone Development Deck',
    tagline: 'Distributed dev platform across three nodes',
    taglinePt: 'Plataforma distribuída de dev em três nós',
    description: 'Arch Linux PC, Android/Termux (LineageOS + root), and Kubernetes on Contabo. Go CLI bridges all three. Three native Android Java apps: Field Console (ops), Amphora Zero (security lab), Agent Code Buddy (mobile HITL for AI agents). Full k8s ops: cert-manager, Cloudflare, Uptime Kuma, systemd backups.',
    descriptionPt: 'PC Arch Linux, Android/Termux (LineageOS + root) e Kubernetes no Contabo. CLI Go conecta os três. Três apps Android nativos em Java: Field Console (ops), Amphora Zero (lab de segurança), Agent Code Buddy (HITL mobile para agentes IA). K8s completo: cert-manager, Cloudflare, Uptime Kuma, backups systemd.',
    href: '/deck',
    github: 'https://github.com/nfvelten',
    logo: null,
    tags: ['Go', 'Android', 'k3s'],
  },
  {
    name: 'Mate Creations',
    tagline: 'Yerba Mate & Tererê theme family',
    taglinePt: 'Família de temas Yerba Mate e Tererê',
    description: 'A cohesive theme family for Neovim, VSCode, Obsidian, Omarchy and Zen Browser — dark (Yerba Mate) and light (Tererê) covering the entire desktop.',
    descriptionPt: 'Família de temas para Neovim, VSCode, Obsidian, Omarchy e Zen Browser — dark (Yerba Mate) e light (Tererê) cobrindo o ambiente inteiro.',
    href: '/matecreations',
    github: 'https://github.com/mateCreations',
    logo: '/mate-logo.png',
    tags: ['Themes', 'Neovim', 'VSCode'],
  },
];
---

<BaseLayout
  title="Open-Source Projects — Paperboy, Arbitus, Amphora, Mate Creations"
  description="Open-source projects by Nicholas Velten: Paperboy, Arbitus, Amphora, and Mate Creations."
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header">
      <h1>
        <span class="lang-en">Projects</span>
        <span class="lang-pt">Projetos</span>
      </h1>
    </header>
    <div class="prose">
      <div class="projects-list">
        {projects.map((p, i) => (
          <a href={p.href} class={`project-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="project-logo">
              {p.logo
                ? <img src={p.logo} alt={p.name} width="40" height="40" />
                : <span class="project-initial">{p.name[0]}</span>
              }
            </div>
            <div class="project-body">
              <div class="project-top">
                <h2>{p.name}</h2>
                <div class="project-tags">
                  {p.tags.map(t => <span class="tag">{t}</span>)}
                </div>
              </div>
              <p class="project-tagline">
                <span class="lang-en">{p.tagline}</span>
                <span class="lang-pt">{p.taglinePt}</span>
              </p>
              <p class="project-desc">
                <span class="lang-en">{p.description}</span>
                <span class="lang-pt">{p.descriptionPt}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--tx) 8%, transparent);
    border-color: var(--ui-2);
  }

  .project-logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .project-logo img {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
  }

  .project-initial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    font-size: 1rem;
    font-weight: 600;
    color: var(--tx-2);
  }

  .project-body {
    flex: 1;
    min-width: 0;
  }

  .project-top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .project-top h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: var(--bg-2);
    border: 1px solid var(--ui);
    color: var(--tx-3);
    font-family: system-ui, sans-serif;
    transition: background 0.15s, border-color 0.15s;
  }

  .project-card:hover .tag {
    background: var(--bg-2);
    border-color: var(--ui-2);
  }

  .project-tagline {
    font-size: 0.85rem;
    color: var(--tx-2);
    margin-bottom: 0.4rem;
  }

  .project-desc {
    font-size: 0.82rem;
    color: var(--tx-3);
    line-height: 1.5;
    margin: 0;
  }
</style>
