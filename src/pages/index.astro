---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { portfolio } from '../data/portfolio.js';

const { person, positioning, projects, writing } = portfolio;
const featuredProjects = projects.filter((project) => ['Arbitus', 'agent-memory', 'Paperboy', 'Mate Creations'].includes(project.name));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is Nicholas Velten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${person.publicName} is a ${person.title} with five years building and operating production systems, currently in telecom, with a focus on full-stack delivery, distributed workflows, production automation and AI agent infrastructure.`,
      },
    },
    {
      '@type': 'Question',
      name: 'What has Nicholas Velten shipped?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nicholas has shipped PPPoE/RADIUS provisioning recovery, ONU reprovisioning across multiple services, outage-aware work-order enforcement, PII remediation with AES-256-GCM and zero-downtime JDBC migration across eight-plus Java/Spring Boot microservices.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I contact Nicholas Velten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `You can reach Nicholas Velten by email at ${person.email}, on LinkedIn at linkedin.com/in/nicholasvelten, or on GitHub at github.com/nfvelten.`,
      },
    },
  ],
};
---

<BaseLayout
  title="Nicholas Velten — Software Engineer"
  description={positioning.headline}
  jsonLd={faqSchema}
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header reveal">
      <h1 class="gradient-heading">Nicholas Velten</h1>
      <div class="meta">
        <span class="lang-en">{person.title} · {person.location}</span>
        <span class="lang-pt">Engenheiro Backend · {person.locationPt}</span>
      </div>
    </header>

    <div class="prose lang-en">
      {positioning.summary.slice(0, 2).map((paragraph, i) => (
        <p class={`reveal reveal-delay-${i + 1}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">On this site</h2>
      <ul class="reveal reveal-delay-1">
        <li><a href="/about">About</a> — background, stack, work and projects</li>
        <li><a href="/projects">Projects</a> — Arbitus, agent-memory, Paperboy, Mate Creations</li>
        <li><a href="/resume">Resume</a> — full professional background</li>
        <li><a href="/blog">Blog</a> — writing about production systems, AI agents and tooling</li>
        <li><a href="/api/resume.json">Resume JSON</a> — machine-readable profile for agents</li>
      </ul>

      <h2 class="reveal">Open Source</h2>
      <p class="reveal reveal-delay-1">
        I build tools around production correctness, agent safety and personal infrastructure.
        The strongest thread is systems that leave evidence instead of relying on convention.
      </p>
      <ul class="reveal reveal-delay-2">
        {featuredProjects.map((project) => (
          <li><strong><a href={project.href}>{project.name}</a></strong> — {project.description}</li>
        ))}
      </ul>

      <h2 class="reveal">Writing</h2>
      <ul class="reveal reveal-delay-1">
        {writing.map((post) => <li><a href={post.href}>{post.title}</a> — {post.summary}</li>)}
      </ul>

      <h2 class="reveal">Frequently Asked Questions</h2>
      <dl class="reveal reveal-delay-1">
        <div class="faq-item">
          <dt><strong>Who is Nicholas Velten?</strong></dt>
          <dd>{person.publicName} is a {person.title} working across full-stack products, distributed workflows, production automation and AI agent infrastructure, with current domain experience in ISP OSS/BSS and service assurance.</dd>
        </div>
        <div class="faq-item">
          <dt><strong>What has Nicholas shipped?</strong></dt>
          <dd>PPPoE/RADIUS provisioning recovery, ONU reprovisioning, outage-aware work-order enforcement, PII remediation with AES-256-GCM, zero-downtime JDBC migration and agent tooling with policy, audit, memory and human approval.</dd>
        </div>
        <div class="faq-item">
          <dt><strong>How can I contact Nicholas Velten?</strong></dt>
          <dd>
            By email at <a href={`mailto:${person.email}`}>{person.email}</a>,
            on <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            or on <a href={person.links.github} target="_blank" rel="noopener">GitHub</a>.
          </dd>
        </div>
      </dl>
    </div>

    <div class="prose lang-pt">
      {positioning.summaryPt.slice(0, 2).map((paragraph, i) => (
        <p class={`reveal reveal-delay-${i + 1}`}>{paragraph}</p>
      ))}

      <h2 class="reveal">Neste site</h2>
      <ul class="reveal reveal-delay-1">
        <li><a href="/about">Sobre</a> — contexto, stack, trabalho e projetos</li>
        <li><a href="/projects">Projetos</a> — Arbitus, agent-memory, Paperboy, Mate Creations</li>
        <li><a href="/resume">Curriculo</a> — trajetoria profissional completa</li>
        <li><a href="/blog">Blog</a> — escrita sobre producao, agentes de IA e ferramentas</li>
        <li><a href="/api/resume.json">Resume JSON</a> — perfil legivel por agentes</li>
      </ul>

      <h2 class="reveal">Open Source</h2>
      <p class="reveal reveal-delay-1">
        Construo ferramentas em torno de corretude em producao, seguranca de agentes e infraestrutura pessoal.
        O fio mais forte sao sistemas que deixam evidencia em vez de depender de convencao.
      </p>
      <ul class="reveal reveal-delay-2">
        {featuredProjects.map((project) => (
          <li><strong><a href={project.href}>{project.name}</a></strong> — {project.descriptionPt ?? project.description}</li>
        ))}
      </ul>

      <h2 class="reveal">Escrita</h2>
      <ul class="reveal reveal-delay-1">
        {writing.map((post) => <li><a href={post.href}>{post.title}</a> — {post.summary}</li>)}
      </ul>

      <h2 class="reveal">Perguntas frequentes</h2>
      <dl class="reveal reveal-delay-1">
        <div class="faq-item">
          <dt><strong>Quem e Nicholas Velten?</strong></dt>
          <dd>{person.publicName} e engenheiro backend trabalhando com workflows distribuidos, corretude em producao, automacao backend e infraestrutura de agentes de IA, com experiencia atual em OSS/BSS e service assurance de ISP.</dd>
        </div>
        <div class="faq-item">
          <dt><strong>O que Nicholas entregou?</strong></dt>
          <dd>Recuperacao de provisionamento PPPoE/RADIUS, reprovisionamento de ONU, enforcement de OS em massiva, remediacao de PII com AES-256-GCM, migracao JDBC zero-downtime e tooling de agentes com politica, auditoria, memoria e aprovacao humana.</dd>
        </div>
        <div class="faq-item">
          <dt><strong>Como entrar em contato com Nicholas Velten?</strong></dt>
          <dd>
            Por email em <a href={`mailto:${person.email}`}>{person.email}</a>,
            no <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            ou no <a href={person.links.github} target="_blank" rel="noopener">GitHub</a>.
          </dd>
        </div>
      </dl>
    </div>
  </article>
</BaseLayout>
