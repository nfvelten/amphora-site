---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const scripts = [
  {
    id: 'meeting-record',
    name: 'meeting-record',
    desc: 'Grava áudio do microfone e transcreve com Whisper ao parar. Salva automaticamente em Work/Meetings/ com data e resumo gerado pelo Claude.',
    install: null,
  },
  {
    id: 'video-note',
    name: 'video-note',
    desc: 'Baixa legendas de um vídeo do YouTube, resume com Claude e salva em Personal/Videos/ como nota Obsidian.',
    install: null,
  },
  {
    id: 'newsboat-save',
    name: 'newsboat-save',
    desc: 'Scrape + resumo de artigo a partir do Newsboat. Salva em Personal/Reading/ como nota com título, fonte e conteúdo resumido.',
    install: null,
  },
  {
    id: 'vault-log-updates',
    name: 'vault-log-updates',
    desc: 'Loga atualizações de pacotes pacman em Personal/System/Updates.md. Configurável via variáveis de ambiente.',
    install: null,
  },
];

const cliCommands = [
  { cmd: 'amphora install', desc: 'Instala componentes: scripts, hook git, neovim, obsidian, claude' },
  { cmd: 'amphora check', desc: 'Verifica dependências e estado da instalação' },
  { cmd: 'amphora update', desc: 'Atualiza scripts e configurações para a versão mais recente' },
  { cmd: 'amphora guide', desc: 'Abre guia interativo de uso: scripts, hooks, neovim, obsidian' },
  { cmd: 'amphora uninstall', desc: 'Remove componentes instalados' },
];

const integrations = [
  {
    id: 'obsidian',
    name: 'Obsidian',
    desc: 'Templates para daily note, weekly review, nota técnica e demanda de trabalho. Configuração de plugins (obsidian-git, dataview, templater, tasks) pronta para uso.',
    install: 'amphora install obsidian',
  },
  {
    id: 'nvim',
    name: 'Neovim',
    desc: 'Plugin de vault para Neovim com task picker, quick capture e navegação entre notas via obsidian.nvim. Keymaps em <leader>v e <leader>o.',
    install: 'amphora install nvim',
  },
  {
    id: 'hook',
    name: 'Git hook (post-commit)',
    desc: 'Hook que loga commits automaticamente na daily note ao fazer push em qualquer repositório.',
    install: 'amphora install hook',
  },
];
---

<BaseLayout
  title="amphora"
  description="amphora — sistema pessoal de gestão de conhecimento construído sobre Obsidian, Neovim e scripts de automação."
>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header">
      <h1>Amphora</h1>
    </header>
    <div class="prose">
      <div class="amphora-intro">
        <img src="/icon.png" alt="Amphora" class="amphora-logo" />
        <p>
          <strong>Amphora</strong> é um sistema pessoal de gestão de conhecimento (PKMS) construído
          sobre <a href="https://obsidian.md" target="_blank" rel="noopener">Obsidian</a> e
          <a href="https://neovim.io" target="_blank" rel="noopener">Neovim</a>. Combina daily notes,
          automações via scripts e integração com IA para capturar, organizar e recuperar conhecimento
          sem atrito.
        </p>
        <p>
          O repositório <a href="https://github.com/nfvelten/amphora-setup" target="_blank" rel="noopener">amphora-setup</a>{' '}
          publica a CLI <code>amphora</code> (Rust) e os scripts — instalável em qualquer sistema Linux
          com Obsidian. Configurável via variáveis de ambiente (<code>AMPHORA_VAULT</code>,
          <code>AMPHORA_DIR_PERSONAL</code>, <code>AMPHORA_DIR_WORK</code>).
        </p>
      </div>

      <div class="install-block">
        <pre class="theme-install"><code>curl -fsSL https://github.com/nfvelten/amphora-setup/releases/latest/download/amphora-linux-x86_64 -o amphora
chmod +x amphora && ./amphora install</code></pre>
      </div>

      <h2>CLI</h2>

      <div class="cmd-table">
        {cliCommands.map(c => (
          <div class="cmd-row">
            <code class="cmd-name">{c.cmd}</code>
            <span class="cmd-desc">{c.desc}</span>
          </div>
        ))}
      </div>

      <h2>Scripts</h2>

      {scripts.map(s => (
        <div class="theme-entry">
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
          {s.install && (
            <pre class="theme-install"><code>{s.install}</code></pre>
          )}
        </div>
      ))}

      <h2>Integrações</h2>

      {integrations.map(i => (
        <div class="theme-entry">
          <h3>{i.name}</h3>
          <p>{i.desc}</p>
          <pre class="theme-install"><code>{i.install}</code></pre>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  .amphora-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .amphora-logo {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
  }

  .install-block {
    margin: 1.5rem 0 2.5rem;
  }

  .cmd-table {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .cmd-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .cmd-name {
    font-family: 'Cascadia Code', 'Fira Code', monospace;
    font-size: 0.85rem;
    color: var(--tx);
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cmd-desc {
    font-size: 0.9rem;
    color: var(--tx-2);
  }

  .theme-entry {
    margin-bottom: 2rem;
  }

  .theme-entry h3 {
    margin-bottom: 0.25rem;
  }

  .theme-entry p {
    margin-bottom: 0.5rem;
    color: var(--tx-2);
  }

  .theme-install {
    background: var(--bg-2);
    border: 1px solid var(--ui);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    overflow-x: auto;
    margin-top: 0.5rem;
  }

  .theme-install code {
    font-family: 'Cascadia Code', 'Fira Code', monospace;
    color: var(--tx);
  }
</style>
