---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  title: string;
  titlePt?: string;
  date: Date;
  tags?: string[];
  description?: string;
  readingTime?: number;
}

const { title, titlePt, date, tags = [], description, readingTime } = Astro.props;

const formattedDateEn = date.toLocaleDateString('en-US', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const formattedDatePt = date.toLocaleDateString('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const postUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://nicholas-velten.xyz').toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? `${title} — Nicholas Velten`,
  datePublished: date.toISOString(),
  url: postUrl,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Nicholas Velten',
    url: 'https://nicholas-velten.xyz/about',
  },
  publisher: {
    '@type': 'Person',
    name: 'Nicholas Velten',
    url: 'https://nicholas-velten.xyz',
  },
};
---

<BaseLayout title={title} description={description ?? `${title} — Nicholas Velten`} jsonLd={articleSchema}>
  <Sidebar slot="sidebar" />
  <article>
    <header class="post-header">
      <h1>
        <span class="lang-en">{title}</span>
        {titlePt && <span class="lang-pt">{titlePt}</span>}
      </h1>
      <div class="meta">
        <time datetime={date.toISOString()}>
          <span class="lang-en">{formattedDateEn}</span>
          <span class="lang-pt">{formattedDatePt}</span>
        </time>
        {readingTime && (
          <span>
            <span class="lang-en">{readingTime} min read</span>
            <span class="lang-pt">{readingTime} min de leitura</span>
          </span>
        )}
        {tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <Giscus />
  </article>
</BaseLayout>
