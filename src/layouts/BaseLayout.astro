---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import ebVarUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | null;
}
const {
  title = 'Nicholas Velten',
  description = 'Site pessoal de Nicholas Velten — engenheiro de software full-stack. Escrita sobre tecnologia, leituras e aprendizados.',
  image = '/icon.webp',
  jsonLd = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://nicholas-velten.xyz');
const fullTitle = title.includes('Nicholas Velten') ? title : `${title} — Nicholas Velten`;

// Separate JSON-LD blocks (no @graph) so audit tools find each @type at root level
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://nicholas-velten.xyz/#organization',
  name: 'Nicholas Velten',
  url: 'https://nicholas-velten.xyz',
  logo: {
    '@type': 'ImageObject',
    url: 'https://nicholas-velten.xyz/favicon.svg',
    width: 512,
    height: 512,
  },
  sameAs: [
    'https://www.linkedin.com/in/nicholasveltenfullstack',
    'https://github.com/nfvelten',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://nicholas-velten.xyz/#website',
  url: 'https://nicholas-velten.xyz',
  name: 'Nicholas Velten',
  description: 'Site pessoal de Nicholas Velten — engenheiro de software full-stack. Escrita sobre tecnologia, leituras e aprendizados.',
  inLanguage: 'pt-BR',
  publisher: { '@id': 'https://nicholas-velten.xyz/#organization' },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://nicholas-velten.xyz/#person',
  name: 'Nicholas Velten',
  url: 'https://nicholas-velten.xyz/about',
  image: 'https://nicholas-velten.xyz/icon.webp',
  jobTitle: 'Full-Stack Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Alloha Fibra' },
  email: 'nikvelten@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/nicholasveltenfullstack',
    'https://github.com/nfvelten',
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical.toString()}#webpage`,
  url: canonical.toString(),
  name: fullTitle,
  description: description,
  inLanguage: 'en',
  isPartOf: { '@id': 'https://nicholas-velten.xyz/#website' },
  about: { '@id': 'https://nicholas-velten.xyz/#person' },
  publisher: { '@id': 'https://nicholas-velten.xyz/#organization' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Tema por horário + idioma: sem flash -->
    <script is:inline>
      (function () {
        var h = new Date().getHours();
        document.documentElement.setAttribute('data-theme', (h >= 6 && h < 18) ? 'light' : 'dark');
        var lang = localStorage.getItem('lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" as="font" type="font/woff2" href={ebVarUrl} crossorigin />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="canonical" href={canonical} />

    <!-- SEO -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonical)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.webp" type="image/webp" sizes="500x500" />
    <ViewTransitions />
    <link rel="alternate" type="application/rss+xml" title="Nicholas Velten" href="/rss.xml" />
    <title>{fullTitle}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <style is:global>
      @import '../styles/global.css';
    </style>

    <script>
      document.addEventListener('astro:before-swap', (ev) => {
        const theme = document.documentElement.getAttribute('data-theme');
        const lang = document.documentElement.getAttribute('data-lang');
        if (theme) (ev as any).newDocument.documentElement.setAttribute('data-theme', theme);
        if (lang) {
          (ev as any).newDocument.documentElement.setAttribute('data-lang', lang);
          (ev as any).newDocument.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
        }
      });
    </script>
  </head>
  <body>
    <div class="wrapper">
      <slot name="sidebar" />
      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>
